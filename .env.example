# ==============================================================================
# SQL Frontier Eval - Environment Configuration Template
# Copy this file to .env and populate credentials: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 19 Configuration (Local Docker Compose)
# ------------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=sql_frontier_eval

# ------------------------------------------------------------------------------
# 2. Databricks SQL Warehouse / Unity Catalog Configuration
# ------------------------------------------------------------------------------
# Server Hostname: e.g. "dbc-xxxxxxxx-xxxx.cloud.databricks.com" (Workspace URL, omit https://)
DATABRICKS_SERVER_HOSTNAME=

# HTTP Path: From SQL Warehouse or Cluster "Connection Details" tab
# e.g. "/sql/1.0/warehouses/0123456789abcdef"
DATABRICKS_HTTP_PATH=

# Databricks Personal Access Token (PAT) or Service Principal OAuth Token
# Generate under Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=

# Unity Catalog name (defaults to "main" if not specified)
DATABRICKS_CATALOG=main

# Isolated sandbox schema for evaluation runs (will be created automatically)
DATABRICKS_SCHEMA=sql_frontier_eval_sandbox
